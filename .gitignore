# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# IDE & editor
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo
*~
scripts

# OS
.DS_Store
Thumbs.db

# Pi / Maestro runtime artifacts (see .workflow/specs/ for tracked config)
.history/
.pi/settings.local.json
.pi/scratch/
# Runtime capture records under .pi/agents stay ignored; role definitions
# (*.md) are versioned and ship inside the npm package for global discovery.
.pi/agents/*
!.pi/agents/*.md
# Runtime monitor ledger (per-session binding/supervision trace).
.pi/monitor-ledger.jsonl
# Materialized by prepare-package-skills/sync-pi; canonical sources live at
# the workspace root .pi.
packages/pi-maestro-flow/.pi/

# Sync toolchain staging dir (replaces the old tracked flow/ mirror)
.pi-sync/
.maestro-lifecycle.coordinator
.workflow/*.pid
.workflow/.backups/
.workflow/recovery/
.workflow/.csv-wave/
.workflow/.maestro/
.workflow/.scratchpad/
.workflow/sessions/
.workflow/embedding-index.bin
.workflow/embedding.zvec/
.workflow/embedding.zvec.meta.json
.workflow/explore/
.workflow/impeccable/
.workflow/kg/
.workflow/search-cache.json
.workflow/search-daemon.json
.workflow/spec-analytics.jsonl
.workflow/specs/.hit-log.jsonl
.workflow/specs/learnings.md
.workflow/specs/quality-rules.md
.workflow/specs/test-conventions.md
.workflow/specs/ui-conventions.md
.workflow/state.json
.workflow/tmp/
.workflow/swarms/
.workflow/wiki-index.json

# Scratch session artifacts
.workflow/scratch/*/.history/
.workflow/scratch/*/.summaries/
.workflow/scratch/*/.task/
.workflow/scratch/*/evidence.ndjson
.workflow/scratch/*/session.json
.workflow/scratch/*/tasks.csv
.workflow/scratch/*/wave-*-results.csv
.workflow/scratch/*/verify-*.txt
.workflow/scratch/*/verify-*.md
.workflow/scratch/*/execute-stage.patch
.workflow/scratch/*/*.ndjson
.workflow/scratch/*/*.csv
.workflow/scratch/*/*.txt
.workflow/scratch/*/*.patch

# Nested package artifacts
packages/*/dist/
packages/*/node_modules/
packages/*/package/
packages/*/.workflow/
packages/*/.tmp-*.log
packages/*/.verify-*.ts

# Python cache artifacts
__pycache__/
*.py[cod]

# Local development sandboxes
.local/

# Misc
nul
.pi/model-failover.json

# Reference clones (nested repos, not vendored)
.references/

# Team swarm runtime session artifacts
.workflow/.team/

# One-off tooling scratch
add-imports.mjs
idx-names.txt

# Eval artifacts (pi-terminal-bench / tbench21 runs)
.cache/
filter.py
instr.txt

# self-evolve runtime artifacts (global output lives in ~/.maestro/self-evolve)
.pi/self-evolve/
.pi/self-evolve.json

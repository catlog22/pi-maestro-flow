{
  "name": "pi-maestro-backends",
  "version": "0.1.7",
  "description": "Teammate execution backends. Every backend here implements the same pi-maestro-backend-core contract — including the Pi subprocess, which is an ordinary member rather than a bypass.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-transform-types --test \"test/*.test.ts\"",
    "test:e2e": "node --experimental-transform-types --test --test-timeout=300000 test/dsh-runtime.e2e.test.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./child-env": "./src/child-env.ts",
    "./dsh": "./src/dsh/index.ts",
    "./dsh/driver": "./src/dsh/driver.ts",
    "./dsh/todo-endpoint": "./src/dsh/todo-endpoint.ts",
    "./dsh/structured-output": "./src/dsh/structured-output.ts",
    "./fabric": "./src/fabric/index.ts",
    "./remote": "./src/remote/index.ts"
  },
  "files": [
    "src/**/*.ts"
  ],
  "keywords": [
    "pi",
    "maestro",
    "teammate",
    "backend"
  ],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "pi-maestro-backend-core": "0.1.5",
    "pi-maestro-fabric-core": "0.1.0",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-sdk-client": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-sdk-client": {
      "optional": true
    }
  }
}

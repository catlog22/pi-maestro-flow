{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run session-context",
            "timeout": 600,
            "statusMessage": "Loading workflow context",
            "async": false
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run spec-injector",
            "timeout": 600,
            "statusMessage": "Loading project specs",
            "async": false
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run kg-auto-init",
            "timeout": 600,
            "statusMessage": "Initializing knowledge graph",
            "async": false
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run search-daemon-start",
            "timeout": 600,
            "statusMessage": "Starting search daemon",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run skill-context",
            "timeout": 600,
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run keyword-spec-injector",
            "timeout": 600,
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run kg-sync",
            "timeout": 600,
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run delegate-monitor",
            "timeout": 600,
            "async": false
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run search-cache-invalidator",
            "timeout": 600,
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run coordinator-tracker",
            "timeout": 600,
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run team-monitor",
            "timeout": 600,
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run telemetry",
            "timeout": 600,
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run preflight-guard",
            "timeout": 600,
            "statusMessage": "Running preflight checks",
            "async": false
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "maestro hooks run spec-validator",
            "timeout": 600,
            "statusMessage": "Validating against specs",
            "async": false
          }
        ]
      }
    ]
  }
}
